{
  "name": "rs-packers-movers",
  "version": "1.0.0",
  "private": true,
  "description": "RS Packers & Movers - website, quotation API and booking workflow",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @rs/api\" \"npm run dev -w @rs/web\"",
    "build": "npm run build -w @rs/web && npm run build -w @rs/api",
    "start": "node apps/api/dist/main.js",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "assets:logo": "node scripts/process-logo.mjs",
    "assets:founder": "node scripts/process-founder-photo.mjs",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "prepare": "node scripts/prepare.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml,html}": "prettier --write"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
