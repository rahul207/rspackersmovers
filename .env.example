# =============================================================================
# RS Packers & Movers - environment configuration
# Copy to `.env` and edit. NEVER commit `.env`. All variables are validated at startup;
# the API refuses to start with a clear message when something is invalid.
# Empty values are treated as "not configured" for optional settings.
# =============================================================================

# --- Runtime ------------------------------------------------------------------
# NODE_ENV: development | test | production
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# LOG_LEVEL: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Set to the number of reverse proxies in front of the API (0 = none). Needed for correct rate limiting.
TRUST_PROXY=0

# --- Public site --------------------------------------------------------------
# Canonical origin used for links, sitemap, structured data and Open Graph tags (no trailing slash).
PUBLIC_SITE_URL=http://localhost:5173

# --- Business details (shown on the site; anything left empty is hidden gracefully) ---
BUSINESS_NAME=RS Packers & Movers
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_ADDRESS=
# Complete international format, e.g. +91 98XXX XXXXX. Spaces, brackets, hyphens and "+" are stripped
# when building https://wa.me/<digits>. Leave empty to disable the WhatsApp buttons/redirect.
WHATSAPP_NUMBER=
# Optional social profile URLs (hidden when empty)
SOCIAL_FACEBOOK_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_LINKEDIN_URL=
SOCIAL_YOUTUBE_URL=
SOCIAL_X_URL=
# Policy pages. Defaults are the placeholder pages shipped with the site (legal review required).
PRIVACY_POLICY_URL=/privacy
COOKIE_POLICY_URL=/cookie-policy
TERMS_URL=/terms
CANCELLATION_POLICY_URL=/cancellation-policy
# Contact for privacy/data-subject requests (falls back to BUSINESS_EMAIL, then to /data-request)
DATA_REQUEST_EMAIL=

# --- Location lookup ----------------------------------------------------------
# The quote form asks for a 6-digit PIN code, lists its post offices from the free India Post
# directory (api.postalpincode.in), then finds the chosen area's coordinates from free open
# sources (Open-Meteo, Photon, Nominatim). No API key needed.
# live = use those services (default)   offline = built-in fixtures, for dev and automated tests
LOCATION_LOOKUP=live

# --- Excel (XLSX) storage - low-volume initial deployment only -----------------
QUOTES_XLSX_PATH=./storage/quote-requests.xlsx
CONTACTS_XLSX_PATH=./storage/contact-requests.xlsx
CONSENTS_XLSX_PATH=./storage/consent-records.xlsx
VISITORS_XLSX_PATH=./storage/visitor-analytics.xlsx
# Rotating backups are written to <storage dir>/backups
XLSX_BACKUPS_TO_KEEP=10
XLSX_BACKUP_MIN_INTERVAL_MINUTES=60

# --- Privacy ------------------------------------------------------------------
# Visitor analytics still requires the visitor's explicit consent
ENABLE_VISITOR_ANALYTICS=true
# Serves Swagger UI at /api/docs
ENABLE_API_DOCS=true
# Personal data older than this is deleted (checked at startup and every 24 hours)
DATA_RETENTION_DAYS=365
# Header set by your CDN/proxy with an ISO country code (e.g. cf-ipcountry). IPs are never stored.
GEO_COUNTRY_HEADER=cf-ipcountry

# --- Abuse protection ---------------------------------------------------------
RATE_LIMIT_MAX=100
# Per client per minute for quote and contact submissions
SUBMISSION_RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
# Comma-separated list of allowed browser origins for cross-origin calls. Same-origin needs none.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# none | turnstile (Cloudflare Turnstile). With turnstile both keys are required.
CAPTCHA_PROVIDER=none
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# --- Secrets (>= 32 characters; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
# The placeholders below are accepted ONLY outside production.
SESSION_SECRET=change-me-development-only-session-secret-0001
COOKIE_SIGNING_SECRET=change-me-development-only-cookie-secret-0002

# --- Static web files ---------------------------------------------------------
# Serve the built frontend from the API (default in production, off in development: use Vite).
SERVE_WEB=false
WEB_DIST_PATH=./apps/web/dist

# --- Future PostgreSQL adapter (reserved, unused by this version) ---------------
DATABASE_URL=
